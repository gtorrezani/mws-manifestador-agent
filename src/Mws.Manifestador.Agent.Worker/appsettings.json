{
  "AgentApi": {
    "BaseUrl": "https://api.example.com",
    "ActivationCode": null
  },
  "AgentPolling": {
    "IntervalSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "MaxCommandsPerPoll": 5
  },
  "Sefaz": {
    "SchemaDirectory": "schemas/nfe",
    "SchemaValidation": {
      "Enabled": true,
      "Strict": true,
      "SchemasPath": "Schemas/NFe",
      "ValidateOutgoing": true,
      "ValidateIncoming": true,
      "FailOnUnknownSchema": true
    },
    "Distribution": {
      "ConsumptionDeniedRetryAfterMinutes": 60
    },
    "DiagnosticXmlLogging": false,
    "EventBatchLimit": 20,
    "AllowProductionDistribution": false
  },
  "LocalDiagnostics": {
    "Enabled": false,
    "ListenUrl": "http://127.0.0.1:8787"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\MWS Manifestador Agent\\logs\\mws-agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "MWS Manifestador Agent"
    }
  }
}
