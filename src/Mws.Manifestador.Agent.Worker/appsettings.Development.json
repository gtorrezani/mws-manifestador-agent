{
  "AgentApi": {
    "BaseUrl": "http://127.0.0.1:8020",
    "ActivationCode": null
  },
  "AgentPolling": {
    "IntervalSeconds": 10,
    "HeartbeatIntervalSeconds": 10,
    "MaxCommandsPerPoll": 5
  },
  "Sefaz": {
    "SchemaValidation": {
      "Enabled": true,
      "Strict": false,
      "SchemasPath": "Schemas/NFe",
      "ValidateOutgoing": true,
      "ValidateIncoming": true,
      "FailOnUnknownSchema": false
    },
    "Distribution": {
      "ConsumptionDeniedRetryAfterMinutes": 60
    }
  },
  "LocalDiagnostics": {
    "Enabled": true,
    "ListenUrl": "http://127.0.0.1:8022"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}
