<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1416;S2221</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mws.Manifestador.Agent.Application\Mws.Manifestador.Agent.Application.csproj" />
    <ProjectReference Include="..\Mws.Manifestador.Agent.Infrastructure\Mws.Manifestador.Agent.Infrastructure.csproj" />
    <ProjectReference Include="..\Mws.Manifestador.Agent.Sefaz\Mws.Manifestador.Agent.Sefaz.csproj" />
  </ItemGroup>

</Project>
